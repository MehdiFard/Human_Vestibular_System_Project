# Load fastqs list
fq_list = pd.read_csv("../src/path_to_fqs.tsv", sep="\t")

# Adding "../" cuase now I'm reading from the matching_analysis directory
fq_list['R1'] = "../" + fq_list['R1'].astype(str)
fq_list['R2'] = "../" + fq_list['R2'].astype(str)

# Define libraries to exclude
excluded_libs = ["FTL_500", "FTL_501"]

# Filter out excluded libraries
fq_list = fq_list[~fq_list['library_id'].isin(excluded_libs)]

# Create list of (library_id, human_id) tuples
bam_info = list(fq_list[['library_id', 'human_id']].itertuples(index=False, name=None))

# Read bam IDs from updated bam_list
with open("src/bam_list.txt") as f:
    bam_ids = [line.strip() for line in f if line.strip()]

# # Read bam IDs from src/bam_list.txt
# bam_ids = glob_wildcards("data/bam/{lib_id}.Aligned.sortedByCoord.out.bam")


rule all:
    input:
        "../data/rna_fq/.symlinks_done",
        expand("data/bam/{lib_id}.Aligned.sortedByCoord.out.bam", lib_id=[lib for lib, hum in bam_info]),
        # "data/bam/FTL_500_501.Aligned.sortedByCoord.out.bam", # Uncomment and fix the issue with FTL_500_501
        "src/Homo_sapiens.GRCh38.110.chr.collapsed.genes.gtf",
        "src/GRCh38_exon_regions.tsv.gz",
        "data/genotype/geno_lifted_phased_hg38_allchrs_inter_cln.vcf.gz",
        "data/genotype/geno_lifted_phased_hg38_allchrs_inter_cln.vcf.gz.tbi",
        "data/genotype/geno_lifted_phased_hg38_for_mixup_test.vcf.gz",
        "data/genotype/geno_lifted_phased_hg38_for_mixup_test.vcf.gz.tbi",
        "src/Homo_sapiens.GRCh38.dna_sm.primary_assembly.fa.fai",
        "src/Homo_sapiens.GRCh38.dna_sm.primary_assembly.dict",
        expand("results/ase_count/{bam_id}.readcounts.txt", bam_id=bam_ids)


rule symlink_fastq:
    """Create symbolic links to all files and folders in the top level of the RNA-seq FASTQ directory."""
    output:
        "../data/rna_fq/.symlinks_done"
    params:
        src="/data/hps/assoc/private/gdml/user/sesmae/projects_data/vestibular_project_data/human/rnaseq_fastq",
        dest="../data/rna_fq/"
    shell:
        r"""
        mkdir -p {params.dest}
        ln -sf {params.src}/* {params.dest}
        touch {output}
        """

