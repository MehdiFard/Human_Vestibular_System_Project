rule map_star:
    input:
        R1 = lambda wildcards: fq_list.loc[fq_list['library_id'] == wildcards.lib_id, 'R1'].values[0],
        R2 = lambda wildcards: fq_list.loc[fq_list['library_id'] == wildcards.lib_id, 'R2'].values[0]
    output:
        bam = "data/bam/{lib_id}.Aligned.sortedByCoord.out.bam"
    params:
        star = "/data/hps/assoc/private/gdml/user/sesmae/tools/STAR-2.7.11b/source/STAR",
        out_prefix = "data/bam/{lib_id}.",
        star_index = "/data/hps/assoc/private/gdml/user/sesmae/refs_gtfs_indx_vcfs/GRCh38.p14_ensembl/index_star",
        sample_id = lambda wildcards: fq_list.loc[fq_list['library_id'] == wildcards.lib_id, 'human_id'].values[0]
    threads: 16
    log:
        "logs/map_star/{lib_id}.log"
    shell:
        """
        # Making read group info
        IDENTIFIRE=$(head -n 1 <(zcat {input.R1}))
        INSTRO_NAME=$(echo $IDENTIFIRE | awk -F ':' '{{print $1}}' | cut -f 2 -d " " | sed 's/@//')
        RUN_ID=$(echo $IDENTIFIRE | awk -F ':' '{{print $2}}')
        FLOWCELL=$(echo $IDENTIFIRE | awk -F ':' '{{print $3}}')
        LANE=$(echo $IDENTIFIRE | awk -F ':' '{{print $4}}')
        TILE=$(echo $IDENTIFIRE | awk -F ':' '{{print $5}}')

        RGID=$FLOWCELL.$LANE
        RGSM={params.sample_id}
        RGLB={wildcards.lib_id}
        RGPU=$FLOWCELL.$LANE.$TILE
        RGPL="ILLUMINA"

        mkdir -p data/bam/
        mkdir -p logs/map_star/

        # Run STAR alignment
        {params.star}   --runMode alignReads \
                        --runThreadN {threads} \
                        --genomeDir {params.star_index} \
                        --readFilesIn {input.R1} {input.R2} \
                        --readFilesCommand zcat \
                        --twopassMode Basic \
                        --quantMode TranscriptomeSAM GeneCounts \
                        --outSAMstrandField intronMotif \
                        --outSAMattrRGline ID:$RGID SM:$RGSM LB:$RGLB PL:$RGPL PU:$RGPU \
                        --outSAMtype BAM SortedByCoordinate \
                        --outSAMunmapped Within \
                        --outFileNamePrefix {params.out_prefix} \
                        &> {log}
        """


rule map_star_FTL_500_FTL_501:
    input:
        RUN1_R1="../data/rna_fq/batch1/FTL_500_S9_L003_R1_001.fastq.gz",
        RUN1_R2="../data/rna_fq/batch1/FTL_500_S9_L003_R2_001.fastq.gz",
        RUN2_R1="../data/rna_fq/batch1/FTL_501_S10_L003_R1_001.fastq.gz",
        RUN2_R2="../data/rna_fq/batch1/FTL_501_S10_L003_R2_001.fastq.gz"
    output:
        bam = "data/bam/FTL_500_501.Aligned.sortedByCoord.out.bam"
    params:
        star = "/data/hps/assoc/private/gdml/user/sesmae/tools/STAR-2.7.11b/source/STAR",
        out_prefix = "data/bam/FTL_500_501.",
        star_index = "/data/hps/assoc/private/gdml/user/sesmae/refs_gtfs_indx_vcfs/GRCh38.p14_ensembl/index_star",
        sample_id = "31661958"
    threads: 16
    log:
        "logs/map_star/FTL_500_FTL_501.log"
    shell:
        r"""
        # Making read group info
        IDENTIFIRE=$(head -n 1 <(zcat {input.RUN1_R1}))
        INSTRO_NAME=$(echo $IDENTIFIRE | awk -F ':' '{{print $1}}' | cut -f 2 -d " " | sed 's/@//')
        RUN_ID=$(echo $IDENTIFIRE | awk -F ':' '{{print $2}}')
        FLOWCELL=$(echo $IDENTIFIRE | awk -F ':' '{{print $3}}')
        LANE=$(echo $IDENTIFIRE | awk -F ':' '{{print $4}}')
        TILE=$(echo $IDENTIFIRE | awk -F ':' '{{print $5}}')

        RGID=$FLOWCELL.$LANE
        RGSM={params.sample_id}
        RGLB="FTL_500_FTL_501"
        RGPU=$FLOWCELL.$LANE.$TILE
        RGPL="ILLUMINA"

        # Run STAR alignment
        {params.star}   --runMode alignReads \
                        --runThreadN {threads} \
                        --genomeDir {params.star_index} \
                        --readFilesIn {input.RUN1_R1},{input.RUN2_R1} {input.RUN1_R2},{input.RUN2_R2} \
                        --readFilesCommand zcat \
                        --twopassMode Basic \
                        --quantMode TranscriptomeSAM GeneCounts \
                        --outSAMstrandField intronMotif \
                        --outSAMattrRGline ID:$RGID SM:$RGSM LB:$RGLB PL:$RGPL PU:$RGPU \
                        --outSAMtype BAM SortedByCoordinate \
                        --outSAMunmapped Within \
                        --outFileNamePrefix {params.out_prefix} \
                        &> {log}
        """

### Running ASE analysis (mamba - Env1)
rule collapse_annotation:
    """Combine all isoforms of a gene into a single transcript.
    See https://github.com/broadinstitute/gtex-pipeline/tree/master/gene_model
    """
    input:
        gtf_hg38 = "src/Homo_sapiens.GRCh38.110.chr.gtf"
    output:
        gtf_collapsed = "src/Homo_sapiens.GRCh38.110.chr.collapsed.genes.gtf"
    shell:
        """
        python3 scripts/collapse_annotation.py {input.gtf_hg38} {output.gtf_collapsed}
        """

rule extract_exon_regions:
    """
    Extract exon regions from the collapsed GTF file and save as a gzipped TSV.
    """
    input:
        gtf = "src/Homo_sapiens.GRCh38.110.chr.gtf"
    output:
        exon_regions = "src/GRCh38_exon_regions.tsv.gz"
    shell:
        """
        grep -v '^#' {input.gtf} | awk '$3=="exon"' | cut -f1,4,5 | gzip -c > {output.exon_regions}
        """


rule filter_and_index_vcf:
    """
    Filter and index the phased VCF using plink2 and tabix.
    """
    input:
        vcf = "../phasing_imputation/results/phased_vcf/geno_lifted_phased_hg38_allchrs.vcf.gz",
        ref = "src/Homo_sapiens.GRCh38.dna_sm.primary_assembly.fa"
    output:
        vcf = "data/genotype/geno_lifted_phased_hg38_allchrs_inter_cln.vcf.gz",
        tbi = "data/genotype/geno_lifted_phased_hg38_allchrs_inter_cln.vcf.gz.tbi"
    params:
        out_prefix = "data/genotype/geno_lifted_phased_hg38_allchrs_inter_cln"
    shell:
        """
        plink2  --vcf {input.vcf} \
                --rm-dup \
                --maf 0.05 \
                --fa {input.ref} \
                --ref-from-fa force \
                --not-chr X Y \
                --snps-only 'just-acgt' \
                --recode vcf id-paste=iid bgz \
                --max-alleles 2 \
                --out {params.out_prefix}
        # Index
        tabix -p vcf {output.vcf}
        """


rule filter_vcf_for_mixup_test:
    """
    Filter the VCF to exonic regions and variants suitable for mixup testing.
    """
    input:
        vcf = "data/genotype/geno_lifted_phased_hg38_allchrs_inter_cln.vcf.gz",
        regions = "src/GRCh38_exon_regions.tsv.gz"
    output:
        vcf = "data/genotype/geno_lifted_phased_hg38_for_mixup_test.vcf.gz",
        tbi = "data/genotype/geno_lifted_phased_hg38_for_mixup_test.vcf.gz.tbi"
    shell:
        """
        bcftools view {input.vcf} \
                --regions-file {input.regions} \
                -Ou | bcftools view \
                --min-af 0.1:minor \
                -i 'F_MISSING<0.01 && N_ALT=1' \
                -Oz -o {output.vcf}
        # Index
        tabix -p vcf {output.vcf}
        """


rule index_reference_genome:
    """
    Create .fai and dictionary index for the reference genome.
    """
    input:
        ref = "src/Homo_sapiens.GRCh38.dna_sm.primary_assembly.fa"
    output:
        fai = "src/Homo_sapiens.GRCh38.dna_sm.primary_assembly.fa.fai",
        dict = "src/Homo_sapiens.GRCh38.dna_sm.primary_assembly.dict"
    shell:
        """
        # .fai index
        gatk CreateSequenceDictionary \
                R={input.ref} \
                O={output.dict}
        
        # .dict index
        samtools faidx {input.ref}
        """


rule make_bam_list:
    """
    Generate the BAM list.
    """
    output:
        "src/bam_list.txt"
    shell:
        """
        mkdir -p src
        ls -1 data/bam/*.Aligned.sortedByCoord.out.bam | cut -f3 -d"/" | cut -f1 -d"." > {output}
        """


rule ase_read_counter:
    """
    Runing ASE analysis.
    """
    input:
        bam = "data/bam/{bam_id}.Aligned.sortedByCoord.out.bam",
        ref = "src/Homo_sapiens.GRCh38.dna_sm.primary_assembly.fa",
        vcf = "data/genotype/geno_lifted_phased_hg38_for_mixup_test.vcf.gz"
    output:
        "results/ase_count/{bam_id}.readcounts.txt"
    threads: 1
    log:
        "logs/ase/{bam_id}.log"
    shell:
        """
        mkdir -p results/ase_count logs/ase

        gatk ASEReadCounter \
                -R {input.ref} \
                -I {input.bam} \
                -V {input.vcf} \
                -O {output} \
                --verbosity ERROR \
                &> {log}
        """


rule rna_to_genotype_similarity:
    """
    Check the similarity between RNA and genotype using ASE results.
    """
    input:
        vcf = "data/genotype/geno_lifted_phased_hg38_for_mixup_test.vcf.gz",
        count_dir = "results/ase_count/",
        samples = "src/bam_list.txt"
    output:
        matrix = "results/rna_to_genotype_similarity.tsv",
        summary = "results/rna_to_genotype_summary.tsv"
    shell:
        """
        python3 scripts/rna_to_geno_similarity.py \
                {input.vcf} \
                {input.count_dir} \
                {input.samples} \
                {output.matrix} \
                {output.summary}
        """


rule summarize_matching:
    """
    Summarize the matching results from RNA to genotype.
    """
    input:
        mixup_result = "results/rna_to_genotype_summary.tsv",
        metadata = "../src/metadata_rna.tsv"
    output:
        output_file = "results/mixup_table_forcheck.tsv"
    shell:
        """
        Rscript scripts/summarize_matching.R \
                {input.mixup_result} \
                {input.metadata} \
                {output.output_file}
        """ 


