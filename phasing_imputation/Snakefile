        # expand("/data/hps/assoc/private/gdml/user/sesmae/refs_gtfs_indx_vcfs/vcfs/1kgp_30x_hg38_phased/1kGP_high_coverage_Illumina.chr{chrs}.filtered.SNV_INDEL_SV_phased_panel.vcf.gz.tbi", chrs=chrs),
