## Phasing using Eagle
rule dl_ref_vcf:
    """Download the reference panel VCF files from 1k Genomes Phase 3, hg38"""
    output:
        multiext("/data/hps/assoc/private/gdml/user/sesmae/refs_gtfs_indx_vcfs/vcfs/1kgp_phase3_hg38_phased/ALL.chr{chrs}_GRCh38.genotypes.20170504.vcf.", "gz", "gz.tbi")
    params:
        vcf_link = "https://cgl.gi.ucsc.edu/data/giraffe/construction/ALL.chr{chrs}_GRCh38.genotypes.20170504.vcf.gz",
        vcf_tbi_link = "https://cgl.gi.ucsc.edu/data/giraffe/construction/ALL.chr{chrs}_GRCh38.genotypes.20170504.vcf.gz.tbi",
        output_dir = "/data/hps/assoc/private/gdml/user/sesmae/refs_gtfs_indx_vcfs/vcfs/1kgp_phase3_hg38_phased/"
    shell:
        """
        wget -P {params.output_dir} {params.vcf_link} 
        wget -P {params.output_dir} {params.vcf_tbi_link}
        """


