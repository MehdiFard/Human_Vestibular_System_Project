#             | sed 's/^/TRAIT\tMODALITY\t/' \
#             > {output.out}
#         for trait in {params.traits}; do
#             for modality in {params.modalities}; do
#                 tail -n+2 results/{wildcards.dataset}/output/$modality/$modality.$trait.tsv \
#                     | awk '$18 < 5e-8 / {params.n_modalities}' \
#                     | sed "s/^/$trait\t$modality\t/" \
#                     >> {output.out}
#             done
#         done
#         """


rule assemble_hits_all_traits_modalities:
    input:
        expand('results/{dataset}/output/{modality}/{modality}.{trait}.tsv',
                dataset=datasets, modality=modalities, trait=traits)
    output:
        out = 'results/{dataset}/output/twas_hits.tsv'
    params:
        traits = ' '.join(traits),
        modalities = ' '.join(modalities),
        n_modalities = len(modalities),
    shell:
        """
        mkdir -p results/{wildcards.dataset}/output
        head -n1 {input[0]} \
            | sed 's/^/TRAIT\tMODALITY\t/' \
            > {output.out}
        for trait in {params.traits}; do
            for modality in {params.modalities}; do
                tail -n+2 results/{wildcards.dataset}/output/$modality/$modality.$trait.tsv \
                    | awk '$18 < 5e-8 / {params.n_modalities}' \
                    | sed "s/^/$trait\t$modality\t/" \
                    >> {output.out}
            done
        done
        """


### END

rule annotate_hits:
    # TWAS.Z sign correction for weights made before the FUSION fix (see annotate_twas_hits.R) + gene symbols
    input: 'results/{dataset}/output/twas_hits.tsv'
    output: 'results/{dataset}/output/twas_hits_annot.tsv'
    params: old_weight_modalities = ",".join(m for m in modalities if m != "RNA_editing")   # "none" after a full re-run
    shell: f"{RS} scripts/annotate_twas_hits.R {{wildcards.dataset}} {{params.old_weight_modalities}}"

rule all_tests:
    # every TWAS test of protein-coding / lncRNA genes in one table, same TWAS.Z sign correction (Fig 4c)
    input: expand('results/{{dataset}}/output/{modality}/{modality}.{trait}.tsv', modality=modalities, trait=traits)
    output: 'results/{dataset}/output/twas_all_tests.tsv.gz'
    params: old_weight_modalities = ",".join(m for m in modalities if m != "RNA_editing")   # "none" after a full re-run
    resources: mem_mb=32000
    shell: f"{RS} scripts/combine_twas_all_tests.R {{wildcards.dataset}} {{params.old_weight_modalities}}"
