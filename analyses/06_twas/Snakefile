# =====================================================================================================================
# 06 TWAS: FUSION association + coloc of the Pantry pheast weights (../05_pantry/pheast/intermediate/<dataset>/twas)
# with every GWAS trait, combined hits (P < 5e-8 / 7 modalities) and annotation (sign correction + gene symbols).
#   snakemake -s analyses/06_twas/Snakefile --profile profiles/slurm         (from the project root)
# Inputs: GWAS sumstats ../04_gwas_sumstats/results/twas_input, trait list gwas_metadata.tsv,
#         LD reference ../../resources/ldref_1kg_hg38. Output: results/<dataset>/output/twas_hits_annot.tsv
#         (+ twas_all_tests.tsv.gz: every test, for Fig 4c).
# gtex_weights/: TWAS with GTEx tissue weights (side analysis).
# =====================================================================================================================
from pathlib import Path
workdir: str(Path(workflow.basedir))
configfile: str(Path(workflow.basedir).parents[1] / "config" / "config.yaml")
_LAB = Path(workflow.basedir).parents[1] / "config" / "config_lab.yaml"   # lab-specific settings, not in git (overrides config.yaml)
if _LAB.exists():
    configfile: str(_LAB)
# Template for running FUSION TWAS using the weights produced by Pantry Pheast
# This example is based on GWAS data from https://zenodo.org/records/3629742

import pandas as pd
RS = f"{config['conda_prefix']}/{config['envs']['plots']}/bin/Rscript"

datasets = ['vestibular']
# datasets = ['saccule', 'utricle', "vestibular"]
modalities = ['alt_polyA', 'alt_TSS', 'RNA_editing', 'expression', 'isoforms', 'splicing', 'stability']
# modalities = ['expression']
trait_df = pd.read_csv(Path(workflow.basedir) / 'gwas_metadata.tsv', sep='\t')
traits = trait_df['trait'].tolist()
gwas_n = {traits[i]: n for i, n in enumerate(trait_df['sample_size'].tolist())}
# chroms = [f'chr{i + 1}' for i in range(22)]
chroms = [f'{i + 1}' for i in range(22)]

wildcard_constraints:
    modality = "[^.]+",
    dataset = "[a-z]+"
    # dataset = "[a-zA-Z0-9_-]+"


rule all:
    input:
        expand("results/{dataset}/intermediate/{modality}/{trait}/{modality}.{trait}.{chrom}.tsv",
            modality=modalities, trait=traits, chrom=chroms, dataset=datasets),
            # expand("results/{dataset}/output/{modality}/twas_hits.tsv", dataset=datasets, modality=modalities),
            expand("results/{dataset}/output/twas_hits_annot.tsv", dataset=datasets),
            expand("results/{dataset}/output/twas_all_tests.tsv.gz", dataset=datasets)


rule assoc_test_chr:
    input:
        # sumstats = "../input/gwas_sumstat/{trait}.sumstats",
        sumstats = "../04_gwas_sumstats/results/twas_input/{trait}_hg38_twas_input.sumstats.gz",
        weights = "../05_pantry/pheast/intermediate/{dataset}/twas/{modality}.pos",
        ref_ld = lambda wildcards: expand("../../resources/ldref_1kg_hg38/1kg_ldref_hg38_chr{chrom}.{ext}", chrom=[wildcards.chrom], ext=['bed', 'bim', 'fam'])
    output:
        "results/{dataset}/intermediate/{modality}/{trait}/{modality}.{trait}.{chrom}.tsv"
    params:
        weights_dir = "../05_pantry/pheast/intermediate/{dataset}/twas/",
        ref_ld_prefix = "../../resources/ldref_1kg_hg38/1kg_ldref_hg38_chr",
        coloc_p = "5e-8", # Will be divided by number of RNA phenotype going to be tested
        gwas_n = lambda w: gwas_n[w.trait]
    threads: 4
    resources:
        mem_mb = 64000
    shell:
        """
        mkdir -p results/{wildcards.dataset}/intermediate/{wildcards.modality}/{wildcards.trait}
        Rscript ../05_pantry/pheast/scripts/fusion_twas/FUSION.assoc_test.R \
            --sumstats {input.sumstats} \
            --weights {input.weights} \
            --weights_dir {params.weights_dir} \
            --ref_ld_chr {params.ref_ld_prefix} \
            --chr {wildcards.chrom} \
            --coloc_P {params.coloc_p} \
            --GWASN {params.gwas_n} \
            --out {output}
        """


rule assemble_assoc_tests:
    input:
        expand('results/{dataset}/intermediate/{{modality}}/{{trait}}/{{modality}}.{{trait}}.{chrom}.tsv',
        dataset=datasets, modality=modalities, trait=traits, chrom=chroms)
    output:
        out = 'results/{dataset}/output/{modality}/{modality}.{trait}.tsv'
    params:
        output_dir = 'results/{dataset}/output/{modality}',
    group: 'twas'
    shell:
        """
        mkdir -p {params.output_dir}
        head -n1 {input[0]} | cut -f3- > {output.out}
        for fname in {input}; do
            tail -n+2 $fname | cut -f3- >> {output.out}
        done
        """


# rule assemble_hits_all_traits_modalities:
#     input:
#         expand('results/{dataset}/output/{modality}/{modality}.{trait}.tsv',
#         dataset=datasets, modality=modalities, trait=traits)
