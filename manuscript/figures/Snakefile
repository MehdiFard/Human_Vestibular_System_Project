# =====================================================================================================================
# Paper figures. Each figure folder holds its code, panels/ and the final figure (Fig 4 and Supp Fig 3 also
# source_data/). Data preparation is in the analyses (xQTL tables: analyses/05_pantry/results/xqtl_summary).
# Scripts run from the project root.
#   snakemake -s manuscript/figures/Snakefile --profile profiles/slurm -n
#   snakemake -s manuscript/figures/Snakefile --profile profiles/slurm fig3          # one figure
# Inputs: analyses/ results (Pantry, TWAS, GWAS sumstats, expression vs GTEx, DGE), data/gwas_raw_sumstats
# (meta-analysis, MAGMA), partner figures in Fig2/inputs and SuppFig2/inputs, sfFDR results.
# =====================================================================================================================
from pathlib import Path

ROOT = Path(workflow.basedir).parents[1]   # manuscript/figures -> project root
workdir: str(ROOT)
configfile: str(ROOT / "config" / "config.yaml")
_LAB = ROOT / "config" / "config_lab.yaml"   # lab-specific settings, not in git (overrides config.yaml)
if _LAB.exists():
    configfile: str(_LAB)
CP = config["conda_prefix"]; ENV = config["envs"]
RS = lambda env: f"{CP}/{ENV[env]}/bin/Rscript"
PY = f"{CP}/{ENV['base']}/bin/python3"
A = "analyses"
PX = f"{A}/05_pantry/pheast/output/vestibular/qtl"
TWAS = f"{A}/06_twas/results/vestibular/output/twas_hits_annot.tsv"
X = f"{A}/05_pantry/results/xqtl_summary"


rule all:
    input:
        "manuscript/figures/Fig1/panels/manhattan_meta_all.pdf",
        "manuscript/figures/Fig2/panels/panel_a_magma_manhattan_new.pdf",
        "manuscript/figures/Fig3/Fig3.pdf",
        "manuscript/figures/Fig4/Fig4.pdf",
        "manuscript/figures/Fig5/Fig5.pdf",
        "manuscript/figures/SuppFig1/panels/VolcanoPlot_utricle_vs_saccule_batch_corrected.pdf",
        "manuscript/figures/SuppFig2/SuppFig2.pdf",
        "manuscript/figures/SuppFig3/SuppFig3.pdf",
        "manuscript/figures/SuppFig4/SuppFig4_5.5x5.5in.pdf",
        "manuscript/figures/SuppFig5/panels/znf91_expression_vs_age_vestibular.pdf",


# ---- Fig 1: cohort demographics, Manhattan and QQ plots (panels; assembled in Illustrator) ----------------------------
rule fig1:
    output: "manuscript/figures/Fig1/panels/manhattan_meta_all.pdf", "manuscript/figures/Fig1/panels/demographics/panel_A_donut.pdf"
    resources: mem_mb=64000
    shell: f"{RS('plots')} manuscript/figures/Fig1/Fig1_gwas_meta.R && {RS('plots')} manuscript/figures/Fig1/demographic.R"

# ---- Fig 2 (+ Supp Fig 2): MAGMA, GSEM, sfFDR, LocusZoom -------------------------------------------------------------
rule fig2:
    input: "manuscript/figures/Fig2/inputs/GSEM.pdf", "manuscript/figures/SuppFig2/inputs/enrich_in_gtex.pdf", f"{A}/10_sffdr/results/sffdr/results.tsv.gz"
    output: "manuscript/figures/Fig2/panels/panel_a_magma_manhattan_new.pdf", "manuscript/figures/SuppFig2/SuppFig2.pdf"
    resources: mem_mb=64000
    shell: f"{RS('locuszoom')} manuscript/figures/Fig2/Fig2_gwas_annot.R"     # needs locuszoomr

# ---- Fig 3: otolith organs vs GTEx ----------------------------------------------------------------------------------
rule fig3:
    input:
        f"{A}/08_expression_gtex/results/enrichment_BP.tsv",
        f"{A}/08_expression_gtex/results/gtex_vest_logCPM_vestib_gtex_same_pipeline_PCs.RData"
    output: "manuscript/figures/Fig3/Fig3.pdf", "manuscript/figures/Fig3/Fig3_5.8x5.8in.pdf"
    resources: mem_mb=48000
    shell: f"{RS('plots')} manuscript/figures/Fig3/Fig3_expression.R"

# ---- Fig 4: phenotypes, xGenes, TWAS genes per trait ----------------------------------------------------------------
rule fig4:
    input:
        f"{X}/vestibular.phenotypes.tsv.gz", f"{X}/vestibular.comb.qtls.tsv",
        f"{A}/06_twas/results/vestibular/output/twas_all_tests.tsv.gz", f"{A}/06_twas/gwas_metadata.tsv"
    output: "manuscript/figures/Fig4/Fig4.pdf", "manuscript/figures/Fig4/Fig4.png"
    resources: mem_mb=16000
    shell: f"{RS('plots')} manuscript/figures/Fig4/fig4.R"

# ---- Supp Fig 3: multimodal xQTL mapping ----------------------------------------------------------------------------
rule suppfig3:
    input:
        f"{X}/vestibular.phenotypes.tsv.gz", f"{X}/vestibular.comb.qtls.tsv", f"{X}/vestibular.comb.qtls.rel_pos.tsv",
        f"{X}/enrich.vestibular.comb.tsv"
    output: "manuscript/figures/SuppFig3/SuppFig3.pdf", "manuscript/figures/SuppFig3/SuppFig3.png"
    resources: mem_mb=16000
    shell: f"{RS('plots')} manuscript/figures/SuppFig3/suppfig3.R"

# ---- Fig 5 and Supp Fig 4: ZNF91 locus --------------------------------------------------------------------------------
rule znf91_region_cache:
    input: f"{PX}/RNA_editing.cis_independent_qtl.txt.gz"
    output: "manuscript/figures/Fig5/data/cache_znf91_region.rds"
    resources: mem_mb=32000
    shell: f"{RS('locuszoom')} manuscript/figures/Fig5/cache_znf91_region.R"

rule ld_znf91:
    output: "manuscript/figures/Fig5/data/ld_rs695017_1kgEUR.tsv", "manuscript/figures/SuppFig4/data/ld_cross_ancestry_3snps.tsv"
    shell: f"{PY} manuscript/figures/Fig5/ld_rs695017_1kg_eur.py && {PY} manuscript/figures/SuppFig4/ld_cross_ancestry.py"

rule fig5_panels:
    # Fig 5a (and the Supp Fig 4 regional panels), Fig 5c LocusCompare
    input: rules.znf91_region_cache.output, rules.ld_znf91.output, TWAS
    output: "manuscript/figures/Fig5/panels/Fig5a.rds", "manuscript/figures/Fig5/panels/Fig5c.rds", "manuscript/figures/SuppFig4/panels/regional/Supp_Fig4.rds"
    resources: mem_mb=32000
    shell: f"{RS('locuszoom')} manuscript/figures/Fig5/fig5a_suppfig4_regional.R && {RS('locuszoom')} manuscript/figures/Fig5/fig5c_locuscompare.R"

rule fig5:
    # Fig 5b (LocusZoom) is drawn on the page by fig5_assemble.R; output is vector, scaled to the final sizes
    input: rules.fig5_panels.output
    output: "manuscript/figures/Fig5/Fig5.pdf", "manuscript/figures/Fig5/Fig5_6.45x5.02in.pdf"
    resources: mem_mb=32000
    shell: f"{RS('locuszoom')} manuscript/figures/Fig5/fig5_assemble.R"

rule suppfig4:
    input: rules.fig5_panels.output, rules.ld_znf91.output, TWAS
    output: "manuscript/figures/SuppFig4/SuppFig4.pdf", "manuscript/figures/SuppFig4/SuppFig4_5.5x5.5in.pdf"
    resources: mem_mb=32000
    shell: f"{RS('locuszoom')} manuscript/figures/SuppFig4/suppfig_coloc_ld.R"

# ---- Supp Fig 1: utricle vs saccule (PCA here; volcano from analyses/09_dge) ----------------------------------------
rule suppfig1:
    input: f"{A}/09_dge/figures/VolcanoPlot_utricle_vs_saccule_batch_corrected.pdf"
    output:
        "manuscript/figures/SuppFig1/panels/VolcanoPlot_utricle_vs_saccule_batch_corrected.pdf",
        "manuscript/figures/SuppFig1/panels/pca_sac_vs_utr_tmm_logcpm_centered.pdf"
    resources: mem_mb=32000
    shell: f"{RS('base')} manuscript/figures/SuppFig1/suppfig1a_pca_saccule_utricle.R && cp -p {{input}} manuscript/figures/SuppFig1/panels/"

# ---- Supp Fig 5: ZNF91 expression vs age (here) and across GTEx tissues (analyses/08_expression_gtex) ----------------
rule suppfig5:
    input: f"{A}/08_expression_gtex/figures/expr_across_gtex_ENSG00000167232.pdf"
    output:
        "manuscript/figures/SuppFig5/panels/znf91_expression_vs_age_vestibular.pdf",
        "manuscript/figures/SuppFig5/panels/expr_across_gtex_ENSG00000167232.pdf"
    shell: f"{RS('plots')} manuscript/figures/SuppFig5/suppfig5a_znf91_age.R && cp -p {{input}} manuscript/figures/SuppFig5/panels/"
