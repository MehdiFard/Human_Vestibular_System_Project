### Snakemake workflow to perform liftover from hg19 to hg38


rule all:
    input:
        "../data/genotype/.symlinks_done",
        multiext("data/genotype/geno_merged_hg19", ".bed", ".bim", ".fam"),
        "data/genotype/geno_merged_hg19_fixed.fam",
        "results/geno_metadata.tsv",
        "src/hg19.fa",
        "src/hg38.fa",
        "src/hg19ToHg38.over.chain",
        "data/genotype/geno_merged_hg19_clean.vcf.gz",
        "src/hg38.dict",
        "results/geno_lifted_hg38.vcf.gz",
        "results/geno_lifted_hg38.vcf.gz.tbi",
        "results/rejected_variants_to_lift.vcf",
        "results/geno_lifted_hg38_deduped_renamed.bcf",
        "results/geno_lifted_hg38_deduped_renamed.bcf.csi"



rule symlink_genotype_files:
    output:
        touch("../data/genotype/.symlinks_done")
    shell:
        """
        mkdir -p ../data/genotype
        ln -sf /data/hps/assoc/private/gdml/user/sesmae/projects_data/vestibular_project_data/human/genotype/* ../data/genotype/
        touch {output}
        """


rule dl_refs_chain:
    output:
        hg19 = "src/hg19.fa",
        hg38 = "src/hg38.fa",
        chain_file = "src/hg19ToHg38.over.chain"
    params:
        hg19_link = "https://hgdownload.soe.ucsc.edu/goldenPath/hg19/bigZips/hg19.fa.gz",
        hg38_link = "https://hgdownload.soe.ucsc.edu/goldenPath/hg38/bigZips/hg38.fa.gz",
        chain_file_hg19_to_hg38 = "https://hgdownload.soe.ucsc.edu/goldenPath/hg19/liftOver/hg19ToHg38.over.chain.gz"
    shell:
        """
        wget -P src/ {params.hg19_link}
        wget -P src/ {params.hg38_link}
        wget -P src/ {params.chain_file_hg19_to_hg38}
        gunzip -f src/hg19.fa.gz
        gunzip -f src/hg38.fa.gz
        gunzip -f src/hg19ToHg38.over.chain.gz
        """


rule merge_genotypes:
    input:
        geno_b12 = multiext("../data/genotype/batch12/20240129_hg19", ".ped", ".map"),
        geno_b3 = multiext("../data/genotype/batch3/20250515_hg19", ".ped", ".map")
    output:
        multiext("data/genotype/geno_merged_hg19", ".bed", ".bim", ".fam")
    params:
        geno_b12_prefix = "../data/genotype/batch12/20240129_hg19",
        geno_b3_prefix = "../data/genotype/batch3/20250515_hg19"
    log:
        "logs/merge_genotypes.log"
    shell:
        """
        plink \
            --file {params.geno_b12_prefix} \
            --merge {params.geno_b3_prefix} \
            --chr 1-22 \
            --maf 0.01 \
            --snps-only 'just-acgt' \
            --nonfounders \
            --output-chr chrM \
            --make-bed \
            --out data/genotype/geno_merged_hg19 &> {log}
        """


rule fix_fam_metadata:
    input:
        fam = "data/genotype/geno_merged_hg19.fam"
    output:
        fam_fixed = "data/genotype/geno_merged_hg19_fixed.fam",
        geno_meta = "results/geno_metadata.tsv"
    shell:
        """
        Rscript scripts/fix_fam_make_meta.R
        """


rule fix_ref_alt_vcf:
    input:
        bed = "data/genotype/geno_merged_hg19.bed",
        bim = "data/genotype/geno_merged_hg19.bim",
        fam = "data/genotype/geno_merged_hg19_fixed.fam",
        ref_hg19 = "src/hg19.fa"
    output:
        "data/genotype/geno_merged_hg19_clean.vcf.gz"
    shell:
        r"""
        plink2 \
            --bed {input.bed} \
            --bim {input.bim} \
            --fam {input.fam} \
            --fa {input.ref_hg19} \
            --ref-from-fa force \
            --max-alleles 2 \
            --nonfounders \
            --output-chr chrM \
            --set-all-var-ids @_#_\$r_\$a \
            --recode vcf id-paste=iid bgz \
            --out data/genotype/geno_merged_hg19_clean
        """


rule ref_dic:
    input:
        ref_hg38 = "src/hg38.fa"
    output:
        "src/hg38.dict"
    shell:
        """
        gatk CreateSequenceDictionary \
        -R {input.ref_hg38}
        """


rule liftover:
    input:
        geno_vcf = "data/genotype/geno_merged_hg19_clean.vcf.gz",
        chain_file = "src/hg19ToHg38.over.chain",
        ref_hg38 = "src/hg38.fa"
    output:
        vcf_out = "results/geno_lifted_hg38.vcf.gz",
        vcf_out_indx = "results/geno_lifted_hg38.vcf.gz.tbi",
        rejected_vcf = "results/rejected_variants_to_lift.vcf",
    shell:
        """
        gatk LiftoverVcf \
        I={input.geno_vcf} \
        CHAIN={input.chain_file} \
        R={input.ref_hg38} \
        O=results/geno_lifted_hg38.vcf \
        REJECT={output.rejected_vcf} \
        RECOVER_SWAPPED_REF_ALT=true

        # gzip and index
        bgzip results/geno_lifted_hg38.vcf
        tabix -p vcf {output.vcf_out}
        """


rule dedup_rename_bcf:
    """Deduplicate and rename SNP IDs in a VCF, output as BCF."""
    input:
        vcf_in = "results/geno_lifted_hg38.vcf.gz"
    output:
        bcf_out = "results/geno_lifted_hg38_deduped_renamed.bcf",
        bcf_out_indx = "results/geno_lifted_hg38_deduped_renamed.bcf.csi"
    shell:
        r"""
        bcftools annotate --set-id '%CHROM\_%POS\_%REF\_%ALT' {input.vcf_in} | \
        bcftools norm -d exact -Ou | \
        bcftools view -Ob -o {output.bcf_out}
        
        # Index the cleaned BCF
        bcftools index {output.bcf_out}
        """


### END
