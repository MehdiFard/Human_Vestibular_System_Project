from snakemake.utils import min_version
min_version("9.0")

import re
import os
import pandas as pd

container: "docker://ghcr.io/twillis209/sffdr_for_dizziness:latest"

def script_path(script):
    return os.path.join(workflow.basedir, "scripts", script)

# NB: Needs to create cache when running AnnotationHub for the first time.
# Pass --apptainer-args "--bind $HOME/.cache/R/AnnotationHub:$HOME/.cache/R/AnnotationHub"
# (or your cluster's cache equivalent) to persist the AnnotationHub cache across runs.
rule download_ensembl_db:
    output:
        "resources/ensembl_113_hsapiens_edb.sqlite"
    params:
        search_tokens = ["EnsDb", "Homo sapiens", "Ensembl 113"],
        genome = "GRCh38",
    script: script_path("download_edb.R")

rule generate_sffdr_input:
    input:
        # TODO
        primary = "",
        # TODO
        prune = "",
        # TODO
        informative = []
    output:
        # TODO
        ""
    threads: 8
    resources:
        runtime = 60
        # TODO modify this to
    script: script_path("generate_sffdr_input.R")

rule run_sffdr:
    input:
        rules.generate_sffdr_input.output
    output:
        tsv = "results.tsv.gz",
        rds = "results.rds",
        png = "results.png"
    params:
        # TODO this should be a wildcard
        seed = 145
    threads: 16
    resources:
        runtime = 120
    script: script_path("sffdr.R")

checkpoint distance_clump_sffdr:
    input:
        rules.run_sffdr.output
    output:
        "{window_size}_{threshold}_lead_snps.tsv"
    params:
        mhc = False,
        index_threshold = lambda wildcards: 5e-8 if wildcards.threshold == 'gws' else 1e-5,
        distance_window = lambda w: int(w.window_size.split('kb')[0])*1e3,
        p_col = 'fp'
    threads: 16
    resources:
        runtime = 5
    script: script_path("distance_clump.R")

rule annotate_lead_snps_with_missense_and_qtl_info:
    input:
        lead_snps = rules.distance_clump_sffdr.output
    output:
        "{window_size}_{threshold}_lead_snps_with_missense_and_qtl.tsv"
    script: script_path("annotate_with_missense_and_qtl_info.py")

rule annotate_lead_snps_with_nearest_gene:
    input:
        lead = rules.annotate_lead_snps_with_missense_and_qtl_info_for_sffdr.output,
        edb = "resources/gwas/ensembl_113_hsapiens_edb.sqlite"
    output:
        "{window_size}_{threshold}_lead_snps_with_nearest_gene.tsv"
    script: script_path("annotate_with_nearest_gene.R")

rule finalise_lead_snp_annotations:
    input:
        lead_snps = rules.annotate_lead_snps_with_nearest_gene_for_sffdr.output,
        sffdr = rules.run_sffdr.output.tsv
    output:
        "{window_size}_{threshold}_annotated_lead_snps.tsv"
    threads: 8
    resources:
        runtime = 5
    script: script_path("merge_lead_snps_and_sffdr_results.R")

rule draw_manhattan_with_lead_snp_annotation:
    input:
        lead_snps = rules.finalise_lead_snp_annotations_for_sffdr.output,
        gwas = rules.run_sffdr.output.tsv
    output:
        "{window_size}_{threshold}_manhattan_plot.png"
    params:
        width = 12,
        height = 4,
        p_col = 'fp'
    script: script_path("plot_gwas_manhattan.R")
